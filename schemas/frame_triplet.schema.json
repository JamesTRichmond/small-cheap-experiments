{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FrameTriplet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "triplet_id",
    "ts_utc",
    "agent_id",
    "session_id",
    "surface",
    "frame_claim",
    "frame_act",
    "frame_humility",
    "scores",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": "sce.replay.v1" },
    "triplet_id": { "type": "string", "minLength": 1 },
    "ts_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|\\+00:00)$"
    },
    "agent_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_name", "tool_args_hash", "amount_minor", "currency", "merchant_ref"],
      "properties": {
        "tool_name": { "const": "refund.create" },
        "tool_args_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "amount_minor": { "type": "integer" },
        "currency": { "type": "string" },
        "merchant_ref": { "type": ["string", "null"] }
      }
    },
    "frame_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe_id", "probe_family", "probe_text_hash", "response_text", "parsed"],
      "properties": {
        "probe_id": { "type": "string", "minLength": 1 },
        "probe_family": { "type": ["string", "null"] },
        "probe_text_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "response_text": { "type": "string" },
        "parsed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["would_proceed", "uncertainty", "raw_parse_ok"],
          "properties": {
            "would_proceed": { "type": ["boolean", "null"] },
            "uncertainty": {
              "type": "string",
              "enum": ["none", "low", "high", "unknown"]
            },
            "raw_parse_ok": { "type": "boolean" }
          }
        }
      }
    },
    "frame_act": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_name", "executed", "blocked_by_gate", "provider_status", "provider_ref"],
      "properties": {
        "tool_name": { "const": "refund.create" },
        "executed": { "type": "boolean" },
        "blocked_by_gate": { "type": "boolean" },
        "provider_status": { "type": "string" },
        "provider_ref": { "type": ["string", "null"] }
      }
    },
    "frame_humility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimed_uncertainty", "constrained_behavior", "constraint_action"],
      "properties": {
        "claimed_uncertainty": {
          "type": "string",
          "enum": ["none", "low", "high", "unknown"]
        },
        "constrained_behavior": { "type": "boolean" },
        "constraint_action": {
          "type": "string",
          "enum": ["none", "refuse", "escalate", "queue_human"]
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_act_mismatch", "green_then_execute", "humility_failed_to_block"],
      "properties": {
        "claim_act_mismatch": { "type": "integer", "minimum": 0, "maximum": 1 },
        "green_then_execute": { "type": "integer", "minimum": 0, "maximum": 1 },
        "humility_failed_to_block": { "type": "integer", "minimum": 0, "maximum": 1 }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prev_hash", "record_hash"],
      "properties": {
        "prev_hash": { "type": "string", "pattern": "^(genesis|[0-9a-f]{64})$" },
        "record_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
